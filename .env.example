# Chave da Anthropic; só necessária com usar_llm=true. Nunca commitar.
ANTHROPIC_API_KEY=
# Modelo do resolvedor (padrão claude-opus-5-5)
ANTHROPIC_MODEL=
# URL do Postgres (obrigatória na API)
DATABASE_URL=
# Orçamento de tokens por execução (padrão 200000)
LLM_BUDGET_TOKENS=
# Tamanho máximo do upload em MB (padrão 50)
MAX_UPLOAD_MB=
# Pasta de arquivos de entrada e saída (padrão ./data; /data no contêiner)
DATA_DIR=
# Porta HTTP (padrão 8000)
PORT=
# Requisições por minuto por cliente, por processo (padrão 60)
RATE_LIMIT_PER_MINUTE=
# Segredo extra do hash das chaves de API; trocá-lo invalida as chaves existentes
API_KEY_PEPPER=
# 1 roda o worker no processo da API; 0 desliga (padrão 1)
WORKER_IN_PROCESS=
